{
  "manifest_version": 3,
  "name": "Graphin Save",
  "version": "0.1.0",
  "description": "Save the page, a link, or highlighted text to a Graphin network.",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "host_permissions": ["http://localhost:8100/*", "http://localhost:5173/*", "http://127.0.0.1:8765/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Save to Graphin",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
