{
  "manifest_version": 3,
  "name": "Graphin Save",
  "version": "0.2.0",
  "description": "Save the page, a link, or highlighted text to a Graphin network.",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "host_permissions": ["https://graphin.org/*"],
  "content_scripts": [
    {
      "matches": ["https://graphin.org/*"],
      "js": ["bridge.js"]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Save to Graphin",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
