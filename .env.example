# Graphin configuration. Copy this file to .env and edit it. Keep .env out of version control.

# MariaDB connection (XAMPP defaults for local development)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=graphin
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Address of this copy, used in the links sent by email. Leave empty to use the address the app is served from.
APP_URL=

# How email is sent: mail (PHP's mail() on the server) or log (written to storage/mail.log, for development).
MAIL_DRIVER=mail
MAIL_FROM=no-reply@graphin.org

# Show exception details in API error responses. Never enable in production.
APP_DEBUG=false
