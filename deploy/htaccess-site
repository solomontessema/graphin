# Graphin on shared hosting. Uploaded as .htaccess in the site folder.
DirectoryIndex index.html index.php
Options -Indexes

# Never serve these, even if one is uploaded by mistake.
<FilesMatch "\.(sql|md|log|bak|env|lock)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
