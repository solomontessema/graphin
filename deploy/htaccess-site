# Graphin on shared hosting. Uploaded as .htaccess in the site folder.
DirectoryIndex index.html index.php
Options -Indexes

# Never serve these, even if one is uploaded by mistake.
<FilesMatch "\.(sql|md|log|bak|env|lock)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# A shared graph's address, /s/<secret>, is answered by index.php, which adds the graph's name and picture for link previews.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^s/[a-f0-9]{48}/?$ index.php [L]
</IfModule>
